# Dependencias (en cualquier subproyecto, no solo en la raíz)
vendor/
node_modules/

# Configuración local
.env
.env.local
.env.*.local

# Resultado de compilar la aplicación de campo: se construye en cada
# despliegue, no se versiona.
/docs/app/

# Compilados y caché
/public/build/
/public/hot
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
*.cache
.phpunit.result.cache

# Datos locales de contenedores (los volúmenes, no la configuración)
/docker/datos/
/docker/volumenes/

# Herramientas y editores
/.idea/
/.vscode/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
