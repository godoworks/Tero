#
# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# ── Base de datos ────────────────────────────────────────────
DB_NOMBRE=tero
DB_USUARIO=tero
DB_CLAVE=tero_local
DB_PUERTO=5432

# ── Caché y cola de trabajos ─────────────────────────────────
CACHE_PUERTO=6379

# ── Almacenamiento de fotos, firmas y actas ──────────────────
ARCHIVOS_USUARIO=tero
ARCHIVOS_CLAVE=tero_local_2026
ARCHIVOS_PUERTO=9000
ARCHIVOS_CONSOLA_PUERTO=9001

# ── Identidad ────────────────────────────────────────────────
IDENTIDAD_ADMIN=admin
IDENTIDAD_CLAVE=tero_local
IDENTIDAD_PUERTO=8080

# ── Mapas ────────────────────────────────────────────────────
# Teselas de OpenStreetMap. En producción conviene alojarlas o usar un servicio
# propio: el uso del servidor público de OSM tiene límites de cortesía.
MAPA_TESELAS=https://tile.openstreetmap.org/{z}/{x}/{y}.png
